{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.{ts,mjs,js}"],
      "project": ["scripts/**/*.{ts,mjs,js}", "*.{ts,mts,mjs,cjs,js}"]
    },
    "apps/web": {
      "entry": [
        "src/index.tsx",
        "src/config/routes.ts",
        "src/services/*.worker.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.setup.ts",
        "src/**/*.vitest.{ts,tsx}",
        "src/test/**/*.ts",
        "playwright.config.ts",
        "playwright.smoke.config.ts",
        "tests/**/*.spec.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts"],
      "ignoreDependencies": ["vite-bundle-analyzer"]
    },
    "apps/api": {
      "entry": [
        "*.ts",
        "tests/**/*.ts",
        "evals/**/*.ts",
        "scripts/**/*.{ts,js,mjs}",
        "**/*.manual-test.ts"
      ],
      "project": ["**/*.{ts,js,mts,mjs}"],
      "ignore": ["dist/**"]
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "plugins/**/*.js", "metro.config.js"],
      "project": ["**/*.{ts,tsx}"],
      "ignore": [".expo/**", "android/**", "ios/**"]
    },
    "apps/gruen-o-mat": {
      "ignore": ["public/**"]
    },
    "packages/shared": {
      "entry": ["src/index.ts", "src/**/*.vitest.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/tiptap-editor/**"]
    },
    "packages/chat": {
      "entry": [
        "src/index.ts",
        "src/index.native.ts",
        "vitest.config.ts",
        "src/**/*.vitest.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/canvas-editor": {
      "entry": ["src/index.ts", "scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.ts"]
    },
    "packages/sites": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/sites-design": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/eslint-config": {
      "entry": ["base.js", "react.js", "node.js"],
      "project": ["*.js"]
    },
    "services/mcp": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "documentation": {
      "entry": ["docusaurus.config.ts", "sidebars.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": ["@semantic-release/*", "cross-env", "@gruenerator/*"],
  "ignoreWorkspaces": ["apps/desktop", "apps/wordpress"],
  "rules": {
    "binaries": "off"
  }
}
