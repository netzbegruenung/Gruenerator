{
  "name": "@gruenerator/hocuspocus",
  "version": "1.0.0",
  "description": "Gruenerator Hocuspocus - Real-time collaborative editing WebSocket server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "Moritz Wächter",
  "license": "MIT",
  "dependencies": {
    "@gruenerator/shared": "workspace:*",
    "@hocuspocus/extension-logger": "^4.1.2",
    "@hocuspocus/server": "^4.1.2",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "redis": "^6.0.0",
    "winston": "^3.19.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@gruenerator/eslint-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
