{
  "name": "@gruenerator/hocuspocus",
  "version": "1.0.0",
  "private": true,
  "description": "Gruenerator Hocuspocus - Real-time collaborative editing WebSocket server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "author": "Moritz Wächter",
  "license": "MIT",
  "dependencies": {
    "@gruenerator/shared": "workspace:*",
    "@hocuspocus/extension-logger": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "winston": "^3.19.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@gruenerator/eslint-config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
