# Server
PORT=3000

# Qdrant Vector Database
QDRANT_URL=https://your-qdrant-instance.com
QDRANT_API_KEY=your-api-key-here

# Optional: Basic Auth (falls Qdrant so konfiguriert ist)
# QDRANT_BASIC_AUTH_USERNAME=username
# QDRANT_BASIC_AUTH_PASSWORD=password

# Mistral API (für Embeddings)
MISTRAL_API_KEY=your-mistral-api-key

# Optional: Public URL for config generation (leave empty for local testing)
# Will be set when deployed to production
# PUBLIC_URL=https://mcp.gruenerator.eu

# Gruenerator API URL — REQUIRED for the notebooks_* tools AND the runtime
# collection catalog (GET /api/v1/collections). Without it the MCP falls back to
# its bundled static catalog and new collections are NOT picked up.
GRUENERATOR_API_URL=https://api.gruenerator.eu

# Optional: GlitchTip/Sentry error tracking (Sentry-API-compatible).
# Falls back to the shared backend SENTRY_DSN if unset; leave both empty to
# disable. Only sends in NODE_ENV=production. Events are tagged service=mcp.
# SENTRY_DSN_MCP=https://<key>@glitchtip.example.eu/<project-id>
