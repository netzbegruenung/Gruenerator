{
  "name": "@gruenerator/mcp",
  "version": "2.0.0",
  "description": "Gruenerator MCP Server - Suche in Grünen Parteiprogrammen (DE/AT)",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "gruenerator-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx --import ./src/instrument.ts src/index.ts",
    "dev": "tsx watch --import ./src/instrument.ts src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gruene",
    "green-party",
    "qdrant",
    "vector-search",
    "rag"
  ],
  "author": "Moritz Wächter",
  "license": "MIT",
  "dependencies": {
    "@gruenerator/query": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@sentry/node": "^10.57.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gruenerator/eslint-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "eslint": "^9.39.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
