# Grünerator Presenton — Fresh multi-stage Dockerfile
# Deploys Presenton (Apache 2.0) with Keycloak SSO, PostgreSQL, and LiteLLM
# No Ollama, no docling/pytorch, no MCP server

# ─── Stage 1: Build Next.js ──────────────────────────────────────────────────

FROM node:20-slim AS nextjs-builder

WORKDIR /build

COPY servers/nextjs/package.json servers/nextjs/package-lock.json ./
RUN npm install --ignore-scripts

COPY servers/nextjs/ ./
RUN npm run build

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────

FROM python:3.11-slim-bookworm

# System dependencies: nginx, chromium (PDF export), libreoffice (PPTX export)
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    curl \
    chromium \
    fontconfig \
    libreoffice-impress \
    && rm -rf /var/lib/apt/lists/*

# Node.js 20 runtime (for Next.js production server)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Environment
ENV APP_DATA_DIRECTORY=/app_data
ENV TEMP_DIRECTORY=/tmp/presenton
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV NODE_ENV=production

# Python dependencies — upstream deps + our additions (python-jose, httpx)
# No docling/pytorch (saves ~1.5GB), no chromadb (saves ~500MB)
RUN pip install --no-cache-dir \
    alembic aiohttp aiomysql aiosqlite asyncpg \
    "fastapi[standard]" pathvalidate pdfplumber sqlmodel \
    anthropic google-genai openai dirtyjson python-pptx \
    python-jose[cryptography] httpx psycopg2-binary

# Copy built Next.js from builder stage
COPY --from=nextjs-builder /build/.next-build /app/servers/nextjs/.next-build
COPY --from=nextjs-builder /build/node_modules /app/servers/nextjs/node_modules
COPY --from=nextjs-builder /build/public /app/servers/nextjs/public
COPY --from=nextjs-builder /build/package.json /app/servers/nextjs/package.json
COPY --from=nextjs-builder /build/next.config.mjs /app/servers/nextjs/next.config.mjs

# Copy FastAPI source
COPY servers/fastapi/ /app/servers/fastapi/

# Copy our customized startup + nginx (no Ollama, no MCP)
COPY start.gruenerator.js /app/start.js
COPY nginx.gruenerator.conf /etc/nginx/nginx.conf
COPY LICENSE NOTICE /app/

# Persistent data volume
VOLUME /app_data

EXPOSE 80

CMD ["node", "/app/start.js"]
