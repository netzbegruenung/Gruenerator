# Nango Self-Hosted Configuration (Free tier)
# OAuth connector middleware for Google, Microsoft, Atlassian, etc.
# Docs: https://nango.dev/docs/guides/platform/free-self-hosting/configuration

# Database (uses existing Postgres instance, separate database)
NANGO_DB_HOST=host.docker.internal
NANGO_DB_PORT=5432
NANGO_DB_USER=gruenerator
NANGO_DB_PASSWORD=gruenerator
NANGO_DB_NAME=nango

# Public URL (for OAuth callbacks)
NANGO_SERVER_URL=https://nango.gruenerator.eu

# Encryption key for token storage (generate: openssl rand -base64 32)
# Required for Connect UI to work. Cannot be changed after initial setup.
NANGO_ENCRYPTION_KEY=

# Dashboard security (Basic Auth)
FLAG_AUTH_ENABLED=false
NANGO_DASHBOARD_USERNAME=admin
NANGO_DASHBOARD_PASSWORD=

# Telemetry
TELEMETRY=false

# Connect UI
FLAG_SERVE_CONNECT_UI=true
NANGO_PUBLIC_CONNECT_URL=https://nango.gruenerator.eu
SERVER_PORT=3003
CONNECT_UI_PORT=3009
