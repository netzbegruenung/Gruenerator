{
  "name": "@gruenerator/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./stores": {
      "react-native": "./src/stores/index.ts",
      "import": "./src/stores/index.ts",
      "require": "./src/stores/index.ts",
      "types": "./src/stores/index.ts"
    },
    "./pyodide": {
      "import": "./src/pyodide/index.ts",
      "require": "./src/pyodide/index.ts",
      "types": "./src/pyodide/index.ts"
    },
    "./connectors": {
      "import": "./src/connectors/index.ts",
      "require": "./src/connectors/index.ts",
      "types": "./src/connectors/index.ts"
    },
    "./styles": "./src/styles/chat.css",
    "./styles/embedded": "./src/styles/chat-embedded.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:pyodide": "PYODIDE_TESTS=1 vitest run src/pyodide/runCore.integration.vitest.ts"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.31",
    "@assistant-ui/react-markdown": "^0.14.24",
    "@assistant-ui/react-streamdown": "^0.3.20",
    "@assistant-ui/store": "^0.3.22",
    "@gruenerator/collab": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/shared": "workspace:*",
    "@gruenerator/ui": "workspace:*",
    "@gruenerator/voice": "workspace:*",
    "@hocuspocus/provider": "^4.7.1",
    "@streamdown/math": "^1.0.3",
    "assistant-stream": "^0.3.54",
    "beautiful-mermaid": "^1.1.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "30.1.3",
    "pyodide": "^314.0.7",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.28",
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4",
    "zod": ">=3.0.0",
    "zustand": "^5.0.3"
  }
}
