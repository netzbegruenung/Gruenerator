{
  "name": "@gruenerator/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./stores": {
      "react-native": "./src/stores/index.ts",
      "import": "./src/stores/index.ts",
      "require": "./src/stores/index.ts",
      "types": "./src/stores/index.ts"
    },
    "./pyodide": {
      "import": "./src/pyodide/index.ts",
      "require": "./src/pyodide/index.ts",
      "types": "./src/pyodide/index.ts"
    },
    "./styles": "./src/styles/chat.css",
    "./styles/embedded": "./src/styles/chat-embedded.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pyodide": "PYODIDE_TESTS=1 vitest run src/pyodide/runCore.integration.vitest.ts"
  },
  "dependencies": {
    "@assistant-ui/react-markdown": "0.14.2",
    "@gruenerator/collab": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/shared": "workspace:*",
    "@gruenerator/ui": "workspace:*",
    "@gruenerator/voice": "workspace:*",
    "@hocuspocus/provider": "^4.3.0",
    "beautiful-mermaid": "^1.1.3",
    "katex": "^0.16.47",
    "lucide-react": "^1.24.0",
    "radix-ui": "^1.6.2",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.3.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "pyodide": "^0.29.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.14.16",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4",
    "zod": ">=3.0.0",
    "zustand": "^5.0.3"
  }
}
