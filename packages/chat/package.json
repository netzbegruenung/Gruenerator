{
  "name": "@gruenerator/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./stores": {
      "react-native": "./src/stores/index.ts",
      "import": "./src/stores/index.ts",
      "require": "./src/stores/index.ts",
      "types": "./src/stores/index.ts"
    },
    "./styles": "./src/styles/chat.css",
    "./styles/embedded": "./src/styles/chat-embedded.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@assistant-ui/react-markdown": "0.14.1",
    "@gruenerator/collab": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/shared": "workspace:*",
    "@gruenerator/ui": "workspace:*",
    "@gruenerator/voice": "workspace:*",
    "@hocuspocus/provider": "^3.4.4",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.14.8",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4",
    "zod": ">=3.0.0",
    "zustand": "^5.0.3"
  }
}
