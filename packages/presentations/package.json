    "@revealjs/react": "^0.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "reveal.js": "^6.0.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
