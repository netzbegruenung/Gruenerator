{
  "name": "@gruenerator/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sites-richtext": {
      "development": "./src/richtext/index.ts",
      "types": "./src/richtext/index.ts",
      "import": "./dist/richtext/index.js",
      "default": "./dist/richtext/index.js"
    },
    "./presentations-richtext": {
      "development": "./src/richtext/slideBody.ts",
      "types": "./src/richtext/slideBody.ts",
      "import": "./dist/richtext/slideBody.js",
      "default": "./dist/richtext/slideBody.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@gruenerator/core": "workspace:*",
    "@tiptap/core": "3.30.4",
    "@tiptap/extension-bold": "3.29.2",
    "@tiptap/extension-document": "3.29.2",
    "@tiptap/extension-hard-break": "3.29.2",
    "@tiptap/extension-heading": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-italic": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-paragraph": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-text": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/pm": "3.29.2",
    "@tiptap/static-renderer": "3.29.2",
    "@ts-rest/core": "^3.52.1",
    "marked": "^18.0.10",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.32",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gruenerator/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3"
  }
}
