{
  "name": "@gruenerator/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./chat-chart": {
      "import": "./src/components/ChatChart.tsx",
      "types": "./src/components/ChatChart.tsx"
    },
    "./chart": {
      "import": "./src/components/chart.tsx",
      "types": "./src/components/chart.tsx"
    }
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "react-dropzone": "^20.2.1",
    "react-icons": "^5.7.0",
    "recharts": "3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "4"
  }
}
