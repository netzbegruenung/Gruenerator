{
  "name": "@gruenerator/sites-design",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "development": "./src/server.ts",
      "types": "./src/server.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./site.css": "./dist/site.css",
    "./consent.js": "./dist/client/siteConsent.js",
    "./fonts/*": "./assets/fonts/*"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tailwindcss -i ./src/site.css -o ./dist/site.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gruenerator/contracts": "workspace:*",
    "@tiptap/core": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/static-renderer": "^3.34.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
