{
  "name": "@gruenerator/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./avatar": {
      "development": "./src/avatar/index.ts",
      "types": "./src/avatar/index.ts",
      "import": "./dist/avatar/index.js",
      "default": "./dist/avatar/index.js"
    },
    "./models": {
      "development": "./src/models/index.ts",
      "types": "./src/models/index.ts",
      "import": "./dist/models/index.js",
      "default": "./dist/models/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
