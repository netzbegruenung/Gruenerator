{
  "name": "@gruenerator/canvas-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./styles": "./src/canvas-editor.css",
    "./styles/bundle": "./dist/styles/canvas-editor-bundle.css",
    "./stores": {
      "import": "./src/stores/index.ts",
      "require": "./src/stores/index.ts"
    },
    "./formats": {
      "import": "./src/formats/index.ts",
      "require": "./src/formats/index.ts",
      "types": "./src/formats/index.ts"
    },
    "./composer": {
      "import": "./src/composer/index.ts",
      "require": "./src/composer/index.ts",
      "types": "./src/composer/index.ts"
    },
    "./configs/*": "./src/configs/*",
    "./slides": {
      "import": "./src/slides/slideLayouts.ts",
      "require": "./src/slides/slideLayouts.ts",
      "types": "./src/slides/slideLayouts.ts"
    },
    "./zip": {
      "import": "./src/utils/zipPageImages.ts",
      "require": "./src/utils/zipPageImages.ts",
      "types": "./src/utils/zipPageImages.ts"
    },
    "./pixelHitArea": {
      "import": "./src/utils/pixelHitArea.ts",
      "require": "./src/utils/pixelHitArea.ts",
      "types": "./src/utils/pixelHitArea.ts"
    },
    "./stickerElements": {
      "import": "./src/utils/stickerElements.ts",
      "require": "./src/utils/stickerElements.ts",
      "types": "./src/utils/stickerElements.ts"
    },
    "./grueneAssetCatalog": {
      "import": "./src/brand/grueneAssetCatalog.ts",
      "require": "./src/brand/grueneAssetCatalog.ts",
      "types": "./src/brand/grueneAssetCatalog.ts"
    },
    "./profilbildStickers": {
      "import": "./src/utils/profilbildStickerInstances.ts",
      "require": "./src/utils/profilbildStickerInstances.ts",
      "types": "./src/utils/profilbildStickerInstances.ts"
    },
    "./skeleton": {
      "import": "./src/components/CanvasEditorSkeleton.tsx",
      "require": "./src/components/CanvasEditorSkeleton.tsx",
      "types": "./src/components/CanvasEditorSkeleton.tsx"
    },
    "./config-loader": {
      "import": "./src/configs/configLoader.ts",
      "require": "./src/configs/configLoader.ts",
      "types": "./src/configs/configLoader.ts"
    }
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/tailwind-input.css -o ./dist/styles/canvas-editor-bundle.css --minify",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@ggraphic/core": "workspace:*",
    "@ggraphic/editor": "workspace:*",
    "@ggraphic/schema": "workspace:*",
    "@gruenerator/collab": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/shared": "workspace:*",
    "@gruenerator/ui": "workspace:*",
    "@hocuspocus/provider": "^4.7.1",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/flowbite": "^1.2.7",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/iconoir": "^1.2.12",
    "@iconify-json/lucide": "^1.2.144",
    "@iconify-json/ri": "1.2.10",
    "@iconify-json/tabler": "^1.2.42",
    "@iconify/react": "^6.0.2",
    "@iconify/utils": "^3.1.7",
    "@tanstack/react-query": "^5.104.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-bold": "^3.31.4",
    "@tiptap/extension-document": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-italic": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-text": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "immer": "^11.1.21",
    "konva": "^10.7.1",
    "lucide-react": "^1.57.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "~4.0.1",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.7.0",
    "react-icons": "^5.7.0",
    "react-kawaii": "^1.6.0",
    "react-konva": "^19.3.2",
    "recharts": "3.10.1",
    "smartcrop": "2.0.5",
    "tailwind-merge": "^3.7.0",
    "use-image": "^1.1.4",
    "uuid": "^14.0.3",
    "yjs": "^13.6.33",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
