{
  "name": "@gruenerator/canvas-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./styles": "./src/canvas-editor.css",
    "./styles/bundle": "./dist/canvas-editor-bundle.css",
    "./stores": {
      "import": "./src/stores/index.ts",
      "require": "./src/stores/index.ts"
    },
    "./formats": {
      "import": "./src/formats/index.ts",
      "require": "./src/formats/index.ts",
      "types": "./src/formats/index.ts"
    },
    "./configs/*": "./src/configs/*"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/tailwind-input.css -o ./dist/canvas-editor-bundle.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gruenerator/collab": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/shared": "workspace:*",
    "@gruenerator/ui": "workspace:*",
    "@hocuspocus/provider": "^4.1.2",
    "@iconify/react": "^6.0.2",
    "@iconify/utils": "^3.1.3",
    "@radix-ui/react-slider": "^1.4.2",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "immer": "^11.1.8",
    "konva": "^10.3.0",
    "pptxgenjs": "^4.0.1",
    "qrcode.react": "^4.2.0",
    "react-icons": "^5.6.0",
    "react-konva": "^19.2.5",
    "tailwind-merge": "^3.6.0",
    "use-image": "^1.1.4",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
