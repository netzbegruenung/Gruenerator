{
  "name": "@gruenerator/canvas-editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./styles": "./src/canvas-editor.css",
    "./styles/bundle": "./dist/styles/canvas-editor-bundle.css",
    "./stores": {
      "import": "./src/stores/index.ts",
      "require": "./src/stores/index.ts"
    },
    "./formats": {
      "import": "./src/formats/index.ts",
      "require": "./src/formats/index.ts",
      "types": "./src/formats/index.ts"
    },
    "./configs/*": "./src/configs/*"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/tailwind-input.css -o ./dist/styles/canvas-editor-bundle.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@gruenerator/collab": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/shared": "workspace:*",
    "@gruenerator/ui": "workspace:*",
    "@hocuspocus/provider": "^4.6.0",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/flowbite": "^1.2.7",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/react": "^6.0.2",
    "@iconify/utils": "^3.1.7",
    "@tanstack/react-query": "^5.102.8",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-document": "^3.31.3",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "clsx": "^2.1.1",
    "immer": "^11.1.18",
    "konva": "^10.5.0",
    "lucide-react": "^1.43.0",
    "pptxgenjs": "^4.0.1",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react-icons": "^5.7.0",
    "react-kawaii": "^1.6.0",
    "react-konva": "^19.2.7",
    "recharts": "3.10.1",
    "tailwind-merge": "^3.6.0",
    "use-image": "^1.1.4",
    "uuid": "^14.0.2",
    "yjs": "^13.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
