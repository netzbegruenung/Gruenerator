# Gruenerator Production Environment Variables
# Copy to .env and fill in your values
# Used by: docker-compose.prod.yml (api, docs, mcp services)
#
# For Coolify: Add these as environment variables in your service configuration

# =============================================================================
# Required: Domain Configuration
# =============================================================================
DOMAIN=gruenerator.example.com
BASE_URL=https://gruenerator.example.com
AUTH_BASE_URL=https://gruenerator.example.com/api
# Which instance this deployment serves. Unset means `production`; the bgst
# instance sets this — it drives content gating and the unlimited Bäume budget.
# INSTANCE_ID=bgst

# =============================================================================
# Required: AI Service API Keys (at least one required)
# =============================================================================
MISTRAL_API_KEY=
# Regional inference: 'eu' (default) pins requests to api.eu.mistral.ai so
# inference stays in EU/EFTA data centres. Billed at 1.1x list price.
# Files API and Agents have no regional route and always use the global
# endpoint. Set 'global' to opt out entirely. (Speech synthesis no longer runs
# on Mistral at all — see KUGELAUDIO_API_KEY below.)
MISTRAL_REGION=eu
LITELLM_API_KEY=
# GreenPT (OpenAI-compatible, https://api.greenpt.ai/v1)
GREENPT_API_KEY=
GREENPT_DEFAULT_MODEL=mistral-medium-3.5-128b

# Cortecs Sky Inference (OpenAI-kompatibler Router) — Host der Gemma-Lane.
# CORTECS_BASE_URL nur setzen, wenn ein anderer Endpunkt gemeint ist.
# Vorausbezahlt: leeres Guthaben = HTTP 401 auf JEDE Anfrage. Auto-Top-up setzen.
CORTECS_API_KEY=
CORTECS_BASE_URL=
# Melious (Finnland) — zweiter Gemma-Host neben Cortecs. Der Standard-Flavor
# `gemma-4-31b:balanced` trägt nur ~44k Tokens Kontext (gemmaHosts.ts).
MELIOUS_API_KEY=
MELIOUS_DEFAULT_MODEL=
# KugelAudio (Berlin) — Sprachausgabe: Vorlesen im Chat und Sprachassistent.
# Der EU-Host steht als Konstante im Code (services/voice/ttsService.ts), denn
# der Standard-Host api.kugelaudio.com ist geo-geroutet und kann ausserhalb der
# EU antworten. KUGELAUDIO_BASE_URL ist nur der Notausgang davon.
KUGELAUDIO_API_KEY=
KUGELAUDIO_BASE_URL=
# Ganzzahl, kein UUID. Liste: GET /api/voice/tts/voices?language=de. Ohne den
# Wert nimmt KugelAudio seine eigene Standardstimme.
KUGELAUDIO_DEFAULT_VOICE_ID=
# auto = Voxtral, GreenPT als Ausfall-Reserve. voxtral|greenpt pinnt fest.
# (`regolo` wird noch akzeptiert und wie `auto` behandelt — veraltet.)
TRANSCRIPTION_PROVIDER=auto

# =============================================================================
# Required: Database Configuration
# =============================================================================
# PostgreSQL
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=gruenerator
POSTGRES_PASSWORD=
POSTGRES_DATABASE=gruenerator
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Redis (for sessions)
# - Local development (pnpm dev):  redis://localhost:6379
# - Docker Compose (dev/prod):     redis://redis:6379
# - External managed Redis:        redis://user:pass@host:port
REDIS_URL=redis://localhost:6379

# =============================================================================
# Required: Authentication (Keycloak)
# =============================================================================
KEYCLOAK_CLIENT_ID=Gruenerator
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_BASE_URL=https://your-keycloak.example.com
KEYCLOAK_REALM=gruenerator

# Session security
SESSION_SECRET=generate-a-random-32-char-string

# Signs thumbnail URLs (/api/thumbs/...), which render without an auth header.
# Falls back to SESSION_SECRET when unset, but set it separately: rotating
# SESSION_SECRET to invalidate a leaked thumbnail URL logs out every user.
# During a rotation, move the old value to _PREVIOUS for one deploy so URLs in
# already-cached list responses keep resolving.
MEDIA_URL_SIGNING_SECRET=
MEDIA_URL_SIGNING_SECRET_PREVIOUS=

# Where generated thumbnail variants are cached. Defaults to
# apps/api/uploads/thumb-cache. Every file under it is reproducible and can be
# deleted at any time.
THUMBNAIL_CACHE_DIR=

# =============================================================================
# Datenschutz: Art.-9-Einwilligung serverseitig durchsetzen
# =============================================================================
# Auf `true` weisen die KI-Eingänge (Chat, Flux, Voice, Transkription, MCP)
# Aufrufe ohne erteilte Einwilligung mit HTTP 403 / `ai_consent_required` ab.
# Auf `false` (Standard) protokollieren sie nur, wen es treffen würde.
#
# Erst umlegen, wenn das Mobile-Release mit dem Einwilligungs-Dialog im Store
# und hinreichend verbreitet ist: eine bereits installierte Binary kennt das
# Gate nicht, fragt also nie — und wäre ab dem Deploy von allen KI-Funktionen
# ausgesperrt.
ENFORCE_AI_CONSENT=false

# Kopfdaten (Datum, Datumsart, Gremium) hochgeladener Dokumente: neue Uploads
# liest der Worker immer. `true` nimmt auch den Bestand dazu (und Dokumente
# einer älteren Extraktor-Version). Erst nach einem Trockenlauf umlegen:
#   pnpm --filter @gruenerator/api exec tsx scripts/document-meta-backfill.ts --dry-run
DOCUMENT_META_BACKFILL=false

# =============================================================================
# Optional: Qdrant Vector Database
# =============================================================================
QDRANT_URL=https://your-qdrant.example.com/
QDRANT_API_KEY=
QDRANT_BASIC_AUTH_USERNAME=
QDRANT_BASIC_AUTH_PASSWORD=

# =============================================================================
# Optional: External APIs
# =============================================================================
# Bundestag Wrapped MCP (DIP documents, speeches, procedures for the `bundestag`
# chat intent). Defaults to https://mcp.bundestag-wrapped.de in code; override
# only to point at a staging/self-hosted MCP.
BUNDESTAG_MCP_URL=https://mcp.bundestag-wrapped.de

# First-party system MCP sources (chat intents bahn/wetter/news). Each source is
# ACTIVE ONLY when its URL is set — leave empty to disable. The endpoints are
# deploy-env-only by design (never shown to users). Optional shared bearer via
# the matching _TOKEN var.
SYSTEM_MCP_DB_URL=
SYSTEM_MCP_DB_TOKEN=
SYSTEM_MCP_WEATHER_URL=
SYSTEM_MCP_WEATHER_TOKEN=
SYSTEM_MCP_ARD_URL=
SYSTEM_MCP_ARD_TOKEN=
# trivago's official hosted MCP (no auth): https://mcp.trivago.com/mcp
SYSTEM_MCP_TRIVAGO_URL=
SYSTEM_MCP_TRIVAGO_TOKEN=
# German federal law (german-law-mcp). Unlike the four above this is NOT an
# intent — it is a MANAGED CONNECTOR: listed in Einstellungen → Verbindungen for
# every user, on by default, addressable as @gesetze. Setting the URL switches it
# on for the whole deployment. The server requires the shared bearer, so leave
# BOTH empty until the token exists — a URL without a token would list a
# connector that answers 401 on every call.
SYSTEM_MCP_LAW_URL=
SYSTEM_MCP_LAW_TOKEN=

# Gruene API
GRUENE_API_KEY=

# =============================================================================
# Optional: Canva Integration
# =============================================================================
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=https://gruenerator.example.com/api/canva/auth/callback

# =============================================================================
# Optional: Web Search Providers
# =============================================================================
# Linkup (https://docs.linkup.so) — the engine for everything GreenPT cannot
# serve (date windows, domain scope, images, `deep`) and GreenPT's fallback.
# Which engine serves a search is WEB_SEARCH_CHAIN's decision, below.
LINKUP_API_KEY=

# Web search engines in order (apps/api/services/search/webSearch.ts). Each
# search goes to the first engine that has its key and can honour every
# constraint (GreenPT: no date window, domain scope, images or `deep`); a failing
# engine hands over to the next. Swapping engines = editing this line.
# Without GREENPT_API_KEY and LINKUP_API_KEY, add `searxng` (a key-less private
# instance) for local development.
# Replaces GREENPT_SEARCH_ENABLED (ignored since 29.09.2026).
WEB_SEARCH_CHAIN=greenpt,linkup

# Reranking über GreenPT (`green-rerank`, Qwen3-Reranker-4B) — der einzige
# Reranker. Standard: an. Auf `false` wird nicht mehr gererankt: die Aufrufer
# behalten die Retrieval-Reihenfolge.
GREENPT_RERANK_ENABLED=true

# Notebook: Evidenz-Hinweis (#3140) — dunkel ausgeliefert. `evidenceTop` (der
# dichte Spitzenwert VOR dem Rerank) wird immer berechnet und protokolliert;
# das `warning`-Ereignis geht nur mit ENABLED=true hinaus, siehe
# apps/api/config/env.ts für die Kalibrierung des Schwellwerts.
# NOTEBOOK_EVIDENCE_WEAK_ENABLED=false
# NOTEBOOK_EVIDENCE_WEAK_THRESHOLD=0.9356

# @deepresearch runs the research AGENT (plans, delegates to a research
# subagent, reads pages, files the report as a document) whenever
# MISTRAL_API_KEY, CORTECS_API_KEY and LINKUP_API_KEY are set; without them
# it falls back to Linkup's one-shot sourcedAnswer. Capped at 3 runs per user per day.

# =============================================================================
# Optional: Image Generation
# =============================================================================
BFL_API_KEY=

# =============================================================================
# Optional: DeepL (Übersetzer-Werkzeug + Chat-Werkzeug `text_uebersetzen`)
# =============================================================================
# Leave blank to keep translation off (the page shows a notice, the chat tool
# is not mounted). Free-plan keys end in ":fx" and are routed to
# api-free.deepl.com automatically. Never commit a real key.
DEEPL_API_KEY=
# Name of the single account glossary the admin tab manages. Default: Grünerator
# DEEPL_GLOSSARY_NAME=Grünerator

# =============================================================================
# Image generation backend
# =============================================================================
# Backend selection: 'hosted' (BFL API) or 'melious' (`regolo` is still accepted, resolves to melious)
FLUX_BACKEND=hosted

# =============================================================================
# Optional: Speech/Transcription
# =============================================================================
# Transcription runs on MISTRAL_API_KEY (Voxtral) / GREENPT_API_KEY (set above)
# — the provider is picked by TRANSCRIPTION_PROVIDER.

# =============================================================================
# Chat: web search passage distillation
# =============================================================================
# Picks the passages of a crawled page that answer the question, instead of
# handing the model a positional slice of it. Off by default.
CHAT_PASSAGE_DISTILL=false
# The expensive half, gated separately: passage selection is one cross-encoder
# call (~300ms), LLM fact extraction adds ~2-3s per crawled page.
CHAT_PASSAGE_DISTILL_LLM=false

# =============================================================================
# Chat: agentic loop and turn clocks
# =============================================================================
# All of these default sensibly in code — set one only to change that default.
# None of them needs a redeploy, only a restart.

# Der agentische Tool-Loop. Default AN; nur der exakte Wert `false` schaltet ihn
# auf den Single-Pass-Pfad zurueck. Quelle: agenticLoop/flags.ts
# CHAT_AGENT_LOOP=true
# Schritte pro agentischem Turn (Default 8: bis zu 6 Suchen + eine Antwort).
# CHAT_AGENT_LOOP_MAX_STEPS=8
# WEICHES Werkzeugbudget in ms (Default 120000). Ist es aufgebraucht, entzieht
# der Loop die Werkzeuge statt abzubrechen; die harte Decke zieht automatisch
# auf max(300000, 2x diesen Wert) nach. Quelle: agenticLoop/loopBudget.ts
# CHAT_AGENT_LOOP_BUDGET_MS=120000
# Strukturierter turnuebergreifender MCP-Replay. Default AN, `false` schaltet ab.
# CHAT_MCP_REPLAY=true
# ask_human als Loop-Tool (Rueckfrage mitten im Zug, #3220). Default AN,
# `false` schaltet ab. Quelle: agenticLoop/flags.ts
# CHAT_LOOP_ASK_HUMAN=true
# Werkzeug-Umfang pro Turn (toolScope.ts). Default AUS = Schattenbetrieb: das
# Tor protokolliert nur (`scope=shadow`, `scopeMiss=`), der Katalog bleibt voll.
# `true` stellt die eigenen Inhalte wirklich zurueck. Quelle: agenticLoop/flags.ts
# LOOP_TOOL_SCOPE_ENFORCE=false

# Turn-Uhr des Single-Pass-Pfads in ms (Default 180000). Deckelt den GANZEN
# Versuch, auch nachdem Text laeuft. Quelle: responseStreamingService.ts
# CHAT_SINGLE_PASS_WALL_CLOCK_MS=180000
# Dieselbe Uhr fuer eine denkende Lane — sie traegt Denken UND Schreiben
# (Default 280000, bleibt unter nginx' proxy_read_timeout von 300s).
# CHAT_THINKING_WALL_CLOCK_MS=280000
# Wie lange eine denkende Lane bis zum ersten ANTWORT-Token brauchen darf
# (Default 120000). Laeuft es ab, wird der Zug einmal ohne Denken neu gefahren.
# CHAT_REASONING_PHASE_BUDGET_MS=120000

# Abstand zwischen zwei Kontext-Kompaktierungen desselben Threads in ms
# (Default 60000). Wird AUSSERHALB von NODE_ENV=production gelesen — die
# Langthread-Eval braucht Kompaktierungen ohne Wartezeit. Quelle:
# contextPruningService.ts
# CHAT_COMPACTION_COOLDOWN_MS=60000

# =============================================================================
# Internal: Service Configuration (usually don't need to change)
# =============================================================================
# API Service
PORT=3001

# MCP-Server: laeuft in-process in apps/api unter /api/mcp-server.
# MCP_SERVER_PUBLIC_URL ist die oeffentliche Adresse und zugleich die OAuth-
# "resource" — sie muss exakt dem entsprechen, was nginx ausliefert.
MCP_SERVER_PUBLIC_URL=https://mcp.your-domain.com

# Nango (OAuth connector middleware — free self-hosted)
NANGO_SERVER_URL=http://nango:3003
NANGO_PUBLIC_URL=https://nango.gruenerator.eu
NANGO_ENCRYPTION_KEY=              # openssl rand -base64 32
NANGO_SECRET_KEY=                  # from Nango Dashboard → Environment Settings
NANGO_DASHBOARD_PASSWORD=

# Google Picker fuer den Google-Konnektor (Scope drive.file)
GOOGLE_PICKER_API_KEY=             # Browser-Key, nur Picker API + Referrer
GOOGLE_PICKER_APP_ID=              # Cloud-Projektnummer

# Hocuspocus collaborative editing (requires PostgreSQL)
HOCUSPOCUS_ENABLED=true

# Server-to-server canvas/docs/boards API between api and hocuspocus.
# Without the token hocuspocus disables the internal API at startup AND the api
# refuses every call to it — chat sharepic editing, docs content and board live
# updates then fail with "Collab-Dienst nicht erreichbar".
# Both containers read this same .env, so the value must match on both sides.
HOCUSPOCUS_INTERNAL_TOKEN=          # openssl rand -hex 32
# Under docker compose this must name the hocuspocus service, not localhost:
# HOCUSPOCUS_INTERNAL_URL=http://hocuspocus:1241
HOCUSPOCUS_INTERNAL_URL=http://localhost:1241

# =============================================================================
# Optional: Error Tracking (GlitchTip — Sentry-compatible)
# =============================================================================
SENTRY_DSN=                # Backend (apps/api) — GlitchTip DSN
VITE_SENTRY_DSN=           # Frontend (apps/web, apps/sites) — GlitchTip DSN
EXPO_PUBLIC_SENTRY_DSN=    # Mobile (apps/mobile) — GlitchTip DSN

# Frontend Build Variables (set during Docker build, not runtime)
VITE_API_BASE_URL=/api
VITE_APP_ENV=production
VITE_MAINTENANCE_MODE=false
VITE_DOCS_URL=                 # Grünerator Docs URL (defaults to docs.{current hostname})

# Apify (optional — for social media scraping in briefing agents)
APIFY_TOKEN=apfy_api_YOUR_APIFY_TOKEN  # Get from https://console.apify.com/account/integrations

# PolitPro (optional — official polling API for the monitor; Bearer token from politpro.eu account settings)
POLITPRO_API_KEY=

# Content Sync dispatch (PRODUCTION ONLY — fine-grained GitHub PAT, Actions: write on netzbegruenung/Gruenerator; unset = no dispatch)
CONTENT_SYNC_DISPATCH_TOKEN=
