{
  "name": "gruenerator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/hocuspocus",
    "documentation"
  ],
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "26.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "knip": "^6.35.0",
    "lint-staged": "^17.5.0",
    "prettier": "3.9.6",
    "semver": "^7.8.5",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "wait-on": "^9.1.0"
  },
  "scripts": {
    "knip": "knip",
    "prepare": "husky || true",
    "overrides:check": "node scripts/sync-pnpm-overrides.mjs --check",
    "overrides:fix": "node scripts/sync-pnpm-overrides.mjs --fix",
    "overrides:ranges": "node scripts/check-override-ranges.mjs",
    "deps:verify": "node scripts/check-installed-lockfile-drift.mjs",
    "check:internal": "node scripts/check-internal-content.mjs",
    "check:overlays": "node scripts/check-overlay-layers.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck --concurrency=3",
    "typecheck:affected": "cross-env TURBO_SCM_BASE=origin/master turbo run typecheck --affected --concurrency=1",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write --cache --cache-strategy content \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check --cache --cache-strategy content \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "ci": "pnpm check:internal && pnpm check:overlays && turbo run typecheck lint test && pnpm format:check",
    "test": "turbo run test",
    "dev": "concurrently -k -n api,apps -c blue,green \"pnpm dev:backend\" \"wait-on tcp:3001 && turbo run dev --filter=!@gruenerator/api --concurrency=15\"",
    "dev:web": "turbo run dev --filter=@gruenerator/web",
    "dev:backend": "turbo run dev --filter=@gruenerator/api",
    "dev:mobile": "turbo run dev --filter=@gruenerator/mobile",
    "build:web": "turbo run build --filter=@gruenerator/web",
    "build:shared": "turbo run build --filter=@gruenerator/shared",
    "build:desktop": "turbo run build --filter=@gruenerator/desktop",
    "dev:sites": "turbo run dev --filter=@gruenerator/sites",
    "build:sites": "turbo run build --filter=@gruenerator/sites",
    "dev:hocuspocus": "turbo run dev --filter=@gruenerator/hocuspocus",
    "build:docs": "turbo run build --filter=@gruenerator/docs",
    "dev:chat": "turbo run dev --filter=@gruenerator/chat",
    "build:chat": "turbo run build --filter=@gruenerator/chat",
    "dev:documentation": "turbo run dev --filter=@gruenerator/documentation",
    "build:documentation": "turbo run build --filter=@gruenerator/documentation",
    "dev:gruenomat": "turbo run dev --filter=@gruenerator/gruen-o-mat",
    "build:gruenomat": "turbo run build --filter=@gruenerator/gruen-o-mat",
    "generate:thumbs": "tsx packages/canvas-editor/scripts/generateThumbnails.ts",
    "generate:undraw-registry": "tsx packages/canvas-editor/scripts/generateUndrawRegistry.ts",
    "docs:index": "pnpm --filter @gruenerator/documentation docs:index"
  }
}
