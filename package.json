{
  "name": "gruenerator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "canvas"
    ],
    "overrides": {
      "react": "19.2.4",
      "react-dom": "19.2.4",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@hocuspocus/provider": "^3.4.3",
      "@isaacs/brace-expansion": ">=5.0.1",
      "diff": ">=5.2.2",
      "hono": ">=4.12.7",
      "langsmith": ">=0.4.6",
      "markdown-it": ">=14.1.0",
      "tar": ">=7.5.11",
      "undici": ">=7.18.2",
      "rollup": ">=4.59.0",
      "zod": "^3.24.1",
      "better-auth>zod": "^4.3.6",
      "@better-auth/core>zod": "^4.3.6",
      "@types/express-serve-static-core": "^5.0.0",
      "minimatch@<4": ">=3.1.3 <4",
      "minimatch@>=5 <6": ">=5.1.7 <6",
      "minimatch@>=9 <10": ">=9.0.6 <10",
      "ajv@<7": ">=6.14.0 <7",
      "@types/minimatch": "5.1.2",
      "serialize-javascript": ">=7.0.4",
      "webpack-dev-server": ">=5.2.3",
      "@tootallnate/once": ">=2.0.0",
      "loader-utils": "^2.0.4",
      "dompurify": ">=3.2.7",
      "mermaid": ">=10.9.4",
      "srvx": ">=0.11.13",
      "file-type": ">=20.6.0",
      "nanoid": ">=5.0.9"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/comfyui",
    "services/hocuspocus",
    "services/mcp",
    "services/remotion",
    "documentation"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.101.0",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "knip": "^6.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.3",
    "turbo": "^2.9.1",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.4"
  },
  "scripts": {
    "knip": "knip",
    "prepare": "husky || true",
    "release": "semantic-release",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck --concurrency=3",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "ci": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test": "turbo run test",
    "dev": "concurrently -k -n api,apps -c blue,green \"pnpm dev:backend\" \"wait-on tcp:3001 && turbo run dev --filter=!@gruenerator/api --concurrency=15\"",
    "dev:web": "turbo run dev --filter=@gruenerator/web",
    "dev:backend": "turbo run dev --filter=@gruenerator/api",
    "dev:mobile": "turbo run dev --filter=@gruenerator/mobile",
    "build:web": "turbo run build --filter=@gruenerator/web",
    "build:shared": "turbo run build --filter=@gruenerator/shared",
    "build:desktop": "turbo run build --filter=@gruenerator/desktop",
    "build:docs-desktop": "turbo run build --filter=@gruenerator/docs-desktop",
    "dev:sites": "turbo run dev --filter=@gruenerator/sites",
    "build:sites": "turbo run build --filter=@gruenerator/sites",
    "dev:docs": "turbo run dev --filter=@gruenerator/apps-docs",
    "dev:hocuspocus": "turbo run dev --filter=@gruenerator/hocuspocus",
    "build:docs": "turbo run build --filter=@gruenerator/docs",
    "dev:chat": "turbo run dev --filter=@gruenerator/chat",
    "build:chat": "turbo run build --filter=@gruenerator/chat",
    "dev:documentation": "turbo run dev --filter=@gruenerator/documentation",
    "build:documentation": "turbo run build --filter=@gruenerator/documentation",
    "dev:gruenomat": "turbo run dev --filter=@gruenerator/gruen-o-mat",
    "build:gruenomat": "turbo run build --filter=@gruenerator/gruen-o-mat",
    "generate:thumbs": "tsx packages/canvas-editor/scripts/generateThumbnails.ts",
    "generate:undraw-registry": "tsx packages/canvas-editor/scripts/generateUndrawRegistry.ts"
  }
}
