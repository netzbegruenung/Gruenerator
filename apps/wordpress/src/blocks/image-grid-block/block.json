{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "gruenerator/image-grid-block",
  "title": "Link Kacheln",
  "category": "gruenerator-category",
  "icon": "grid-view",
  "description": "Füge ein Raster aus anklickbaren Bildern mit Text hinzu",
  "textdomain": "gruenerator",
  "attributes": {
    "sectionTitle": {
      "type": "string",
      "default": "Aktuelle Themen"
    },
    "items": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"]
  },
  "editorScript": "file:./block.js",
  "editorStyle": "file:./editor.scss",
  "style": "file:./style.scss"
}
