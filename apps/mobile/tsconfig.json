{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitOverride": true,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": false,
    "incremental": true,

    "paths": {
      "@gruenerator/shared": ["../../packages/shared/src/index.ts"],
      "@gruenerator/shared/*": ["../../packages/shared/src/*"],
      // Einzel-Imports der Agent-Symbole (AgentGlyph): Metro nimmt den
      // Quelltext-Export, tsc die veröffentlichten Typen — der Quelltext
      // selbst typcheckt gegen unser react-native-svg nicht.
      "phosphor-react-native/src/icons/*": [
        "../../node_modules/phosphor-react-native/lib/typescript/icons/*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "services/**/*.ts",
    "services/**/*.tsx",
    "stores/**/*.ts",
    "stores/**/*.tsx",
    "theme/**/*.ts",
    "theme/**/*.tsx",
    "utils/**/*.ts",
    "utils/**/*.tsx",
    "types/**/*.ts",
    "types/**/*.d.ts",
    "config/**/*.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "eslint.config.js",
    "jest.config.js",
    "vitest.config.ts"
  ],
  "exclude": ["**/node_modules/**"]
}
