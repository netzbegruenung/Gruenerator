{
  "name": "@gruenerator/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "start:wsl": "./start-expo-wsl.sh",
    "start:tunnel": "./start-expo-wsl.sh",
    "start:android": "./start-expo-android.sh run:android",
    "android": "./start-expo-android.sh run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:android": "EAS_NO_VCS=1 eas build -p android --profile production",
    "build:android:preview": "EAS_NO_VCS=1 eas build -p android --profile preview",
    "eas-build-post-install": "pnpm -w --filter @gruenerator/canvas-editor build:css"
  },
  "dependencies": {
    "@assistant-ui/react-native": "^0.1.15",
    "@expo-google-fonts/raleway": "^0.4.2",
    "@expo/dom-webview": "~56.0.5",
    "@expo/metro-runtime": "~56.0.11",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@gorhom/bottom-sheet": "^5.2.13",
    "@react-native-vector-icons/ionicons": "^13.1.1",
    "@gruenerator/canvas-editor": "workspace:*",
    "@gruenerator/chat": "workspace:*",
    "@gruenerator/collab": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/docs": "workspace:^",
    "@gruenerator/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@tanstack/react-query": "^5.100.9",
    "axios": "^1.16.0",
    "expo": "~56.0.3",
    "expo-audio": "~56.0.9",
    "expo-auth-session": "~56.0.11",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.13",
    "expo-clipboard": "~56.0.3",
    "expo-constants": "~56.0.14",
    "expo-crypto": "~56.0.3",
    "expo-dev-client": "~56.0.14",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-glass-effect": "~56.0.4",
    "expo-image": "~56.0.8",
    "expo-image-picker": "~56.0.12",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.11",
    "expo-media-library": "~56.0.6",
    "expo-notifications": "~56.0.12",
    "expo-router": "~56.2.5",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.12",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "^56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-video": "~56.1.2",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pager-view": "^8.0.1",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.1",
    "react-native-svg": "15.15.4",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.8.3",
    "tus-js-client": "^4.3.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@gruenerator/eslint-config": "workspace:*",
    "@types/react": "^19.2.14",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "typescript": "~6.0.3"
  }
}
