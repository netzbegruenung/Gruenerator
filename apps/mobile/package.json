{
  "name": "@gruenerator/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "@expo/dom-webview"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "start:wsl": "./start-expo-wsl.sh",
    "start:tunnel": "./start-expo-wsl.sh",
    "start:android": "./start-expo-android.sh run:android",
    "android": "./start-expo-android.sh run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "jest",
    "test:e2e": "maestro test maestro/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:android": "EAS_NO_VCS=1 eas build -p android --profile production",
    "build:ios": "EAS_NO_VCS=1 eas build -p ios --profile production",
    "build:all": "EAS_NO_VCS=1 eas build -p all --profile production",
    "build:android:preview": "EAS_NO_VCS=1 eas build -p android --profile preview"
  },
  "dependencies": {
    "@assistant-ui/react-native": "0.1.44",
    "@expo/dom-webview": "~56.0.6",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/ui": "~57.0.21",
    "@gruenerator/chat": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/docs": "workspace:^",
    "@gruenerator/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-auth-session": "~57.0.13",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-and-video-compressor": "^1.0.2",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-intent-launcher": "~57.0.1",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech-recognition": "~56.0.4",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "katex": "^0.18.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-drawer-layout": "^4.2.10",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-markdown-display": "^7.0.2",
    "react-native-pager-view": "^8.0.5",
    "react-native-reanimated": "~4.5.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@gruenerator/eslint-config": "workspace:*",
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/markdown-it": "14.1.2",
    "@types/react": "19.2.18",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "expo-atlas": "^0.4.3",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
