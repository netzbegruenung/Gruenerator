{
  "name": "@gruenerator/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "@expo/dom-webview"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "start:wsl": "./start-expo-wsl.sh",
    "start:tunnel": "./start-expo-wsl.sh",
    "start:android": "./start-expo-android.sh run:android",
    "android": "./start-expo-android.sh run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:native": "jest",
    "test:e2e": "maestro test maestro/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:android": "EAS_NO_VCS=1 eas build -p android --profile production",
    "build:ios": "EAS_NO_VCS=1 eas build -p ios --profile production",
    "build:all": "EAS_NO_VCS=1 eas build -p all --profile production",
    "build:android:preview": "EAS_NO_VCS=1 eas build -p android --profile preview"
  },
  "dependencies": {
    "@assistant-ui/react-native": "0.1.44",
    "@expo/dom-webview": "~58.0.2",
    "@expo/metro-runtime": "~58.0.13",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/ui": "~58.0.14",
    "@gruenerator/chat": "workspace:*",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/docs": "workspace:^",
    "@gruenerator/shared": "workspace:*",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "@mathjax/src": "4.1.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.13.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "expo": "~58.0.6",
    "expo-audio": "~58.0.7",
    "expo-auth-session": "~58.0.9",
    "expo-blur": "~58.0.3",
    "expo-build-properties": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.10",
    "expo-crypto": "~58.0.5",
    "expo-dev-client": "~58.0.11",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.7",
    "expo-font": "~58.0.7",
    "expo-glass-effect": "~58.0.3",
    "expo-haptics": "~58.0.5",
    "expo-image": "~58.0.13",
    "expo-image-and-video-compressor": "^1.0.2",
    "expo-image-manipulator": "~58.0.13",
    "expo-image-picker": "~58.0.10",
