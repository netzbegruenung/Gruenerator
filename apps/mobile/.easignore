# Dependencies (EAS installs these in the cloud)
**/node_modules/

# Native build artifacts (EAS runs prebuild)
apps/mobile/android/
apps/mobile/ios/
apps/docs-expo/android/
apps/docs-expo/ios/

# Other apps not needed for EAS builds (mobile / docs-expo). Workspace members
# keep their package.json: since pnpm 12.8 a frozen install fails when a
# lockfile importer's package.json is missing (ERR_PNPM_OUTDATED_LOCKFILE).
apps/web/*
!apps/web/package.json
apps/api/*
!apps/api/package.json
apps/docs/
apps/desktop/*
!apps/desktop/package.json
apps/sites/
apps/gruen-o-mat/*
!apps/gruen-o-mat/package.json
apps/wordpress/*
!apps/wordpress/package.json

# Services not needed
/services/*
!/services/hocuspocus/
/services/hocuspocus/*
!/services/hocuspocus/package.json

# Reference repos (1.4 GB of cloned repos)
/inspiration/

# Documentation
/documentation/*
!/documentation/package.json

# Playwright, docs, tooling
/.playwright-mcp/
/docs/

# Dev/build artifacts
**/.expo/
**/dist/
**/*.tsbuildinfo
**/.turbo/

# Large media/test files
*.mp4
*.mov
*.avi
*.swp

# Large root files
*.jar
*.md
!README.md
/*.png

# Git
.git/

# IDE / tooling
.idea/
.vscode/
.claude/
.husky/
.github/

# Secrets — keep dev env out of EAS uploads; EXPO_PUBLIC_* would inline into the bundle
**/google-service-account.json
**/.env
**/.env.*
!**/.env.example
