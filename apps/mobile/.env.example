# Copy to `apps/mobile/.env` (gitignored) for local development. EXPO_PUBLIC_* vars are
# inlined into the bundle at build time — keep dev-only flags OUT of release builds.

# Backend base URL. Defaults to production (https://gruenerator.eu/api) when unset.
#   Android emulator: http://10.0.2.2:3001/api
#   iOS simulator:    http://localhost:3001/api
# EXPO_PUBLIC_API_URL=

# DEV-ONLY login bypass for emulator/simulator testing. When true, a fake user is
# seeded so the app renders past the Keycloak auth gate. Tier 1 needs no backend
# (data sections render empty); set EXPO_PUBLIC_API_URL at a local backend for real
# data. MUST stay false/unset in any build you ship.
# EXPO_PUBLIC_DEV_AUTH_BYPASS=false

# Sent as `x-dev-auth-bypass` on every API request while the bypass is on, so a
# local backend with ALLOW_DEV_AUTH_BYPASS=true serves the fake user real data.
# Same value as DEV_AUTH_BYPASS_TOKEN in apps/api/.env.
# EXPO_PUBLIC_DEV_AUTH_BYPASS_TOKEN=

# GlitchTip DSN for error reports. Release builds only (__DEV__ sends nothing).
# EAS builds and updates read it from the EAS environment, not from this file.
# EXPO_PUBLIC_SENTRY_DSN=
