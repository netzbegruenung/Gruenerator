{
  "expo": {
    "name": "Grünerator",
    "slug": "gruenerator",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "gruenerator",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.gruenerator.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Grünerator braucht das Mikrofon, um deine Spracheingabe in Text umzuwandeln.",
        "NSSpeechRecognitionUsageDescription": "Grünerator nutzt die Spracherkennung, um deine gesprochenen Eingaben in Text umzuwandeln.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "de.gruenerator.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#005538"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "gruenerator"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Erlaube Grünerator Zugriff auf deine Fotos für die Reel-Erstellung",
          "cameraPermission": "Erlaube Grünerator die Kamera für Videoaufnahmen zu nutzen"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Erlaube Grünerator, Reels in deiner Galerie zu speichern",
          "savePhotosPermission": "Erlaube Grünerator, Reels in deiner Galerie zu speichern"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-font",
      "expo-notifications",
      "expo-speech-recognition",
      "./plugins/withMediaCapabilities.js",
      "./plugins/withLargeHeap.js",
      "./plugins/withNoSourcemapAssets.js",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "usePrecompiledModules": true
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "usePrecompiledHeaders": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#005538"
        }
      ],
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "./config/withBlockedAndroidMediaPermissions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86989c3a-549f-47fe-b141-df891ff6e075"
      }
    },
    "owner": "moritzius"
  }
}
