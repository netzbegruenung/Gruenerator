  "scripts": {
    "setup:pyodide": "node scripts/setup-pyodide.mjs",
    "dev": "npm run setup:pyodide && vite",
    "start": "npm run setup:pyodide && vite",
    "start:debug": "cross-env NODE_OPTIONS=\"--inspect --max-old-space-size=4096\" vite",
    "optimize-images": "node scripts/optimize-images.mjs",
    "build": "npm run setup:pyodide && cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "build:low-memory": "cross-env NODE_OPTIONS=\"--max-old-space-size=2048 --gc-interval=100\" vite build",
    "build:profile": "cross-env NODE_OPTIONS=--prof vite build",
    "build:sequential": "cross-env NODE_OPTIONS=--max-old-space-size=4096 npm run build:clean && npm run build:chunks",
    "build:clean": "rimraf build && npm run deps:clean",
    "build:chunks": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite build --mode=production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "vite-bundle-analyzer build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:analyze": "npm run build && npm run analyze",
    "deps:check": "npx depcheck",
    "deps:clean": "npm prune && npm dedupe",
    "test:a11y": "playwright test a11y.spec.ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
