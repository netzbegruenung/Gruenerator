{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "noImplicitReturns": false,

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "~/*": ["./*"],
      "@gruenerator/shared": ["../../packages/shared/src"],
      "@gruenerator/shared/*": ["../../packages/shared/src/*"],
      "@gruenerator/docs": ["../../packages/docs/src"],
      "@gruenerator/docs/*": ["../../packages/docs/src/*"],
      "@gruenerator/sites": ["../../packages/sites/src"],
      "@gruenerator/sites/*": ["../../packages/sites/src/*"],
      "@gruenerator/sites-design": ["../../packages/sites-design/src"],
      "@gruenerator/sites-design/*": ["../../packages/sites-design/src/*"],
      "@gruenerator/contracts": ["../../packages/contracts/src/index.ts"],
      "katex/contrib/mhchem": ["src/types/katex-mhchem.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "vitest.config.ts",
    "tests/**/*",
    "playwright.config.ts",
    "playwright.smoke.config.ts"
  ],
  "exclude": ["node_modules", "build", "dist", "test-results", "playwright-report"]
}
