            {
              "type": "headline",
              "lines": ["Die Mitte", "zahlt genug.", "Jetzt sind die", "==Superreichen==", "dran."]
            }
          ],
          "logo": false
        },
        {
          "background": {
            "kind": "farbe",
            "color": "dunkelgruen"
          },
          "position": "mitte",
          "align": "zentriert",
          "items": [
            {
              "type": "absatz",
              "text": "In Österreich ist Vermögen sehr ==ungleich== verteilt."
            },
            {
              "type": "text",
              "text": "Das reichste 1 % besitzt über 40 % des Gesamtvermögens …"
            }
          ],
          "logo": false
        },
        {
          "background": {
            "kind": "farbe",
            "color": "dunkelgruen"
          },
          "position": "mitte",
          "align": "zentriert",
          "items": [
            {
              "type": "absatz",
              "text": "… und das bleibt auch so. Wer zig Millionen erbt, zahlt weiterhin ==keinen Cent Steuern== darauf."
            },
            {
              "type": "absatz",
              "text": "Unsere Regierung kürzt bei Familien, Kindern und Pensionist:innen, anstatt …"
            }
          ],
          "logo": false
        },
        {
          "background": {
            "kind": "farbe",
            "color": "dunkelgruen"
          },
          "position": "mitte",
          "align": "zentriert",
          "items": [
            {
              "type": "headline",
              "lines": ["… Superreiche", "endlich fair zu", "besteuern.", "Das ist", "ungerecht."],
              "akzent": 4
            }
          ],
          "logo": false
        },
        {
          "background": {
            "kind": "farbe",
            "color": "dunkelgruen"
          },
          "position": "mitte",
          "align": "zentriert",
          "items": [
            {
              "type": "absatz",
              "text": "Wer das kleine Vermögen der Eltern erbt, muss dafür keine Steuer zahlen."
            },
            {
              "type": "absatz",
              "text": "Darum sagen wir:",
              "betont": true
            },
            {
              "type": "absatz",
              "text": "Superreiche sollen endlich einen ==fairen Beitrag== zahlen."
            }
          ],
          "logo": true
        }
      ]
    }
  },
