{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "template": {
      "type": "string",
      "minLength": 1
    },
    "textFields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "label",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "currentColorScheme": {
      "type": [
        "string",
        "null"
      ]
    },
    "currentBackgroundColor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "CSS hex color in `#rrggbb` format."
        },
        {
          "type": "null"
        }
      ]
    },
    "currentColorMode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "canvasSize": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "elementsSummary": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "illustration",
              "asset",
              "shape",
              "icon",
              "pill-badge",
              "circle-badge",
              "balken",
              "frame",
              "user-image",
              "text",
              "chart"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "label"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "template",
    "textFields",
    "elementsSummary"
  ],
  "additionalProperties": false
}