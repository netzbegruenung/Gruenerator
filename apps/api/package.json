{
  "name": "@gruenerator/api",
  "version": "1.0.0",
  "description": "Backend for Gruenerator project",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:backend": "PORT=3001 npx tsx --import ./instrument.ts server.ts",
    "start": "npx tsx --import ./instrument.ts server.ts",
    "dev": "cross-env HOCUSPOCUS_ENABLED=true npx tsx watch --import ./instrument.ts server.ts",
    "setup:authentik-sources": "node scripts/setupAuthentikSources.js",
    "setup:authentik-sources:dry-run": "node scripts/setupAuthentikSources.js --dry-run",
    "setup:authentik-sources:force": "node scripts/setupAuthentikSources.js --force",
    "start:dev": "cross-env NODE_ENV=development npm run start:backend",
    "start:dev:no-yjs": "cross-env NODE_ENV=development YJS_ENABLED=false npm run start:backend",
    "start:hocuspocus": "npx tsx ../../services/hocuspocus/src/index.ts",
    "start:prod": "cross-env NODE_ENV=production npm run start:backend",
    "test:embedding": "node scripts/testEmbedding.mjs",
    "download-whisper": "npx nodejs-whisper download",
    "offboarding": "node scripts/offboarding-cron.js",
    "offboarding:status": "node -e \"require('./services/offboardingService').OffboardingService.validateConfig(); console.log('✓ Offboarding configuration is valid');\"",
    "backfill:previews": "node scripts/backfillContentPreviews.mjs",
    "load:bundestag": "node scripts/loadBundestagContent.js",
    "load:bundestag:force": "FORCE_REINDEX=true node scripts/loadBundestagContent.js",
    "sync:bundestag": "node -e \"import('./services/bundestagSyncService.js').then(m => m.getBundestagSyncService().incrementalSync().then(r => { console.log(JSON.stringify(r, null, 2)); process.exit(r.success ? 0 : 1); }))\"",
    "scrape:gruene-at": "npx tsx scrape-gruene-at.ts",
    "scrape:gruene-at:dry-run": "npx tsx scrape-gruene-at.ts --dry-run",
    "scrape:satzungen": "node scripts/scrape-satzungen.js",
    "scrape:satzungen:force": "node scripts/scrape-satzungen.js --force",
    "scrape:satzungen:stats": "node scripts/scrape-satzungen.js --stats",
    "update:all": "npx tsx update-all-content.ts",
    "update:all:dry-run": "npx tsx update-all-content.ts --dry-run",
    "export:finetuning": "npx tsx scripts/exportFineTuningData.ts",
    "export:finetuning:dry-run": "npx tsx scripts/exportFineTuningData.ts --dry-run",
    "export:finetuning:test": "npx tsx scripts/exportFineTuningData.ts --limit 10"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.24",
    "@ai-sdk/openai": "^3.0.41",
    "@anthropic-ai/sdk": "^0.78.0",
    "@blocknote/xl-ai": "^0.47.1",
    "@gruenerator/hocuspocus": "workspace:*",
    "@gruenerator/shared": "workspace:*",
    "@langchain/core": "^1.1.33",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/mistralai": "^1.0.7",
    "@mistralai/mistralai": "^1.15.1",
    "@napi-rs/canvas": "^0.1.97",
    "@pdf-lib/fontkit": "^1.1.1",
    "@qdrant/js-client-rest": "^1.17.0",
    "@sentry/node": "^10.43.0",
    "@tus/file-store": "^2.0.0",
    "@tus/server": "^2.3.0",
    "@types/archiver": "^7.0.0",
    "@types/ws": "^8.18.1",
    "ai": "^6.0.116",
    "apify-client": "^2.22.2",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "crawlee": "^3.16.0",
    "docx": "^9.6.1",
    "domhandler": "^5.0.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "fastembed": "^2.1.0",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.1",
    "ioredis": "^5.10.0",
    "jose": "^6.2.1",
    "jsonrepair": "^3.13.3",
    "kugelaudio": "^0.2.3",
    "langchain": "^1.2.33",
    "marked": "^17.0.4",
    "mem0ai": "^2.4.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.2",
    "openai": "^6.31.0",
    "openid-client": "^6.8.2",
    "passport": "^0.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "redis": "^5.11.0",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "turndown": "^7.2.2",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "yjs": "^13.6.30",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gruenerator/eslint-config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport": "^1.0.17",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
