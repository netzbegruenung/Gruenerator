    "pg": "^8.23.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "redis": "^6.2.1",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.0",
    "turndown": "^7.2.4",
    "undici": "^8.10.0",
    "uuid": "^14.0.2",
    "winston": "^3.19.0",
