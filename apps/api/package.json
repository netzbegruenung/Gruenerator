{
  "name": "@gruenerator/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Gruenerator project",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.integration.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "resume-research": "cross-env NODE_OPTIONS=--conditions=development npx tsx resume-research.ts",
    "eval:chat": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/runChatEval.ts",
    "eval:judge": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/judge/runJudge.ts",
    "eval:bgst": "cross-env EVAL_FILTER=bgst-beleg NODE_OPTIONS=--conditions=development npx tsx evals/runChatEval.ts",
    "eval:bgst:korpus": "cross-env EVAL_FILTER=bgst-korpus EVAL_BGST_KORPUS=1 NODE_OPTIONS=--conditions=development npx tsx evals/runChatEval.ts",
    "eval:bgst:build": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/tools/buildBgstCorpus.ts && cross-env NODE_OPTIONS=--conditions=development npx tsx evals/tools/buildBgstKorpusCorpus.ts",
    "eval:retrieval": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/retrieval/runRetrievalEval.ts",
    "eval:retrieval:compare": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/retrieval/compareOutcomes.ts",
    "eval:retrieval:embed:build": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/build-eval-embed-collection.ts",
    "eval:retrieval:bm25:build": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/build-eval-bm25-collection.ts",
    "eval:retrieval:ann": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/retrieval/annRecallCheck.ts",
    "eval:retrieval:evidence": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/retrieval/evidenceSignalCheck.ts",
    "eval:answer:generate": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/answer/generateAnswers.ts",
    "eval:answer:judge": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/answer/judgeAnswers.ts",
    "eval:answer:sample": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/answer/blindSample.ts",
    "eval:manual:stages": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/retrieval/inspectManualStages.ts",
    "eval:manual:mentions": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/retrieval/mentionCountCheck.ts",
    "eval:cap": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/retrieval/capSaturationCheck.ts",
    "eval:excerpt": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/retrieval/excerptCutCheck.ts",
    "eval:longthread": "cross-env EVAL_SLOW=1 EVAL_FILTER=longthread NODE_OPTIONS=--conditions=development npx tsx evals/runChatEval.ts",
    "eval:mcp:setup": "cross-env NODE_OPTIONS=--conditions=development npx tsx evals/tools/setupMcpServers.ts",
    "eval:mcp": "cross-env EVAL_MCP=1 EVAL_FILTER=mcp NODE_OPTIONS=--conditions=development npx tsx evals/runChatEval.ts",
    "eval:notebook": "cross-env EVAL_NOTEBOOK=1 EVAL_FILTER=notebook NODE_OPTIONS=--conditions=development npx tsx evals/runChatEval.ts",
    "test:auth": "cross-env NODE_OPTIONS=--conditions=development npx tsx tests/betterAuth.test.ts && cross-env NODE_OPTIONS=--conditions=development npx tsx tests/betterAuth.accountCreation.test.ts",
    "test:watch": "vitest",
    "start:backend": "cross-env PORT=3001 NODE_OPTIONS=--conditions=development npx tsx --import ./instrument.ts server.ts",
    "start": "cross-env NODE_OPTIONS=--conditions=development npx tsx --import ./instrument.ts server.ts",
    "dev": "cross-env HOCUSPOCUS_ENABLED=true NODE_OPTIONS=--conditions=development npx tsx watch --import ./instrument.ts server.ts",
    "setup:authentik-sources": "node scripts/setupAuthentikSources.js",
    "setup:authentik-sources:dry-run": "node scripts/setupAuthentikSources.js --dry-run",
    "setup:authentik-sources:force": "node scripts/setupAuthentikSources.js --force",
    "start:dev": "cross-env NODE_ENV=development npm run start:backend",
    "start:dev:no-yjs": "cross-env NODE_ENV=development YJS_ENABLED=false npm run start:backend",
    "start:hocuspocus": "cross-env NODE_OPTIONS=--conditions=development npx tsx ../../services/hocuspocus/src/index.ts",
    "start:prod": "cross-env NODE_ENV=production npm run start:backend",
    "test:embedding": "node scripts/testEmbedding.mjs",
    "offboarding": "node scripts/offboarding-cron.js",
    "offboarding:status": "node -e \"require('./services/offboardingService').OffboardingService.validateConfig(); console.log('✓ Offboarding configuration is valid');\"",
    "backfill:previews": "node scripts/backfillContentPreviews.mjs",
    "load:bundestag": "node scripts/loadBundestagContent.js",
    "load:bundestag:force": "FORCE_REINDEX=true node scripts/loadBundestagContent.js",
    "sync:bundestag": "node -e \"import('./services/bundestagSyncService.js').then(m => m.getBundestagSyncService().incrementalSync().then(r => { console.log(JSON.stringify(r, null, 2)); process.exit(r.success ? 0 : 1); }))\"",
    "scrape:gruene-at": "cross-env NODE_OPTIONS=--conditions=development npx tsx scrape-gruene-at.ts",
    "scrape:gruene-at:dry-run": "cross-env NODE_OPTIONS=--conditions=development npx tsx scrape-gruene-at.ts --dry-run",
    "scrape:satzungen": "node scripts/scrape-satzungen.js",
    "scrape:satzungen:force": "node scripts/scrape-satzungen.js --force",
    "scrape:satzungen:stats": "node scripts/scrape-satzungen.js --stats",
    "docs:check": "cross-env NODE_OPTIONS=--conditions=development npx tsx check-docs-freshness.ts",
    "update:all": "cross-env NODE_OPTIONS=--conditions=development npx tsx update-all-content.ts",
    "migrate:bm25": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/migrate-bm25-sparse.ts",
    "qdrant:patch-hnsw": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/patch-hnsw-indexing.ts",
    "qdrant:drop-usage-logs": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/drop-notebook-usage-logs-collection.ts",
    "update:all:dry-run": "cross-env NODE_OPTIONS=--conditions=development npx tsx update-all-content.ts --dry-run",
    "sync:aggregate": "cross-env NODE_OPTIONS=--conditions=development npx tsx aggregate-sync-summaries.ts",
    "sync:wrap-result": "cross-env NODE_OPTIONS=--conditions=development npx tsx wrap-sync-result.ts",
    "stats:content": "cross-env NODE_OPTIONS=--conditions=development npx tsx generate-content-stats.ts",
    "export:finetuning": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/exportFineTuningData.ts",
    "export:finetuning:dry-run": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/exportFineTuningData.ts --dry-run",
    "export:finetuning:test": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/exportFineTuningData.ts --limit 10",
    "mint-api-key": "cross-env NODE_OPTIONS=--conditions=development npx tsx scripts/mintApiKey.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ai-sdk/mistral": "^4.0.29",
    "@ai-sdk/openai": "^4.0.43",
    "@anthropic-ai/sdk": "^0.115.0",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@blocknote/xl-ai": "^0.54.0",
    "@crawlee/cheerio": "^3.18.1",
    "@crawlee/core": "^3.18.1",
    "@crawlee/playwright": "^3.18.1",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@gruenerator/contracts": "workspace:*",
    "@gruenerator/core": "workspace:*",
    "@gruenerator/hocuspocus": "workspace:*",
    "@gruenerator/shared": "workspace:*",
    "@langchain/core": "^1.2.8",
    "@langchain/langgraph": "^1.4.10",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/openai": "^1.5.6",
    "@langfuse/langchain": "^5.10.0",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@langfuse/vercel-ai-sdk": "^5.10.1",
    "@mistralai/mistralai": "^2.6.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nangohq/node": "^0.71.2",
    "@napi-rs/canvas": "^1.0.7",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@qdrant/js-client-rest": "^1.19.0",
    "@sentry/node": "^10.70.0",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/express": "^3.52.1",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.4",
    "@types/archiver": "^8.0.0",
    "@types/ws": "^8.18.1",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.68",
    "apify-client": "^2.25.0",
    "archiver": "^8.0.0",
    "axios": "^1.19.0",
    "better-auth": "^1.6.26",
    "blurhash": "^2.0.5",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "deepagents": "^1.12.2",
    "docx": "9.7.1",
