{
  "id": "system:merz-briefing",
  "name": "Friedrich Merz Tages-Briefing",
  "description": "Tägliche Zusammenfassung aller Nachrichten über Friedrich Merz",
  "config": {
    "sources": [
      { "type": "web", "query": "Friedrich Merz", "domains": [] },
      {
        "type": "web",
        "query": "Friedrich Merz CDU",
        "domains": ["zeit.de", "spiegel.de", "tagesschau.de"]
      }
    ],
    "language": "de",
    "timeRange": "day",
    "maxResultsPerSource": 15,
    "outputFormat": "digest"
  },
  "schedule_type": "daily",
  "schedule_hour": 20,
  "delivery_email": "moritz-waechter@outlook.de"
}
