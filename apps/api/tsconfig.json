{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "incremental": true
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.js", "**/*.mjs", "types/**/*.d.ts"],
  // Tests are type-checked with the code they test. The two files below import
  // client source (`packages/chat`, `@gruenerator/shared/auth`), which does not
  // compile under this project's NodeNext resolution; their own packages check it.
  "exclude": [
    "node_modules",
    "dist",
    "uploads",
    "test",
    "tests",
    "scripts",
    "**/test-*.ts",
    "routes/chat/services/notebookCitationMap.vitest.ts",
    "services/auth/oauthRequestDefaults.vitest.ts"
  ]
}
