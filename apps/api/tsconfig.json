{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "incremental": true
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.js", "**/*.mjs", "types/**/*.d.ts"],
  // NOTE: `**/*.vitest.ts` is excluded, so `pnpm typecheck` never sees a test
  // file. A `Record<SomeUnion, X>` written in one is decoration, not a check —
  // that is how an incomplete intent map sat in the very test meant to catch
  // incomplete intent maps. scripts/check-unenforced-exhaustive-maps.mjs fails
  // CI when such a map has no runtime loop over the enum behind it.
  // Including the tests here is not a small change: it surfaces ~106 errors
  // across 67 files, mostly partial fixtures under `exactOptionalPropertyTypes`.
  "exclude": [
    "node_modules",
    "dist",
    "uploads",
    "test",
    "tests",
    "scripts",
    "**/test-*.ts",
    "**/*.vitest.ts"
  ]
}
