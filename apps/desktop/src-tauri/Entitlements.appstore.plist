<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store build ONLY. Developer ID / direct-download builds use
         Entitlements.plist (sandbox OFF). The App Store REQUIRES the sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound network for the API / auth / browser-based OAuth -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- File access only via user-selected dialogs (security-scoped) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Downloads folder (for exported content) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>

    <!-- NOTE: com.apple.application-identifier and
         com.apple.developer.team-identifier are NOT set here — they are injected
         from the Mac App Store provisioning profile at sign time. The sandboxed
         build must also EXCLUDE the auto-updater and the LaunchAgent autostart
         (both rejected under sandbox); see MAC-APP-STORE.md for the feature gate. -->
</dict>
</plist>
