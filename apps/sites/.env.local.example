# GlitchTip Error Tracking (Sentry-compatible)
# Get your DSN from GlitchTip: https://app.glitchtip.com
VITE_SENTRY_DSN=https://examplePublicKey@app.glitchtip.com/0

# API Configuration (optional, defaults to /api)
VITE_API_BASE_URL=/api

# Development proxy target (only used in dev mode)
VITE_API_TARGET=http://localhost:3001
