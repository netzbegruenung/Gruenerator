# ============================================================================
# Grünerator Docs - Environment Variables
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ----------------------------------------------------------------------------
# Hocuspocus WebSocket Server
# ----------------------------------------------------------------------------
HOCUSPOCUS_PORT=1240
HOCUSPOCUS_HOST=0.0.0.0

# ----------------------------------------------------------------------------
# PostgreSQL Database
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gruenerator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# ----------------------------------------------------------------------------
# Frontend API Configuration (Vite env vars)
# ----------------------------------------------------------------------------
# Base URL for API requests (relative or absolute)
VITE_API_BASE_URL=/api

# Target API server (used in development proxy)
VITE_API_TARGET=http://localhost:3001

# ----------------------------------------------------------------------------
# Frontend WebSocket Configuration
# ----------------------------------------------------------------------------
# Hocuspocus WebSocket URL for real-time collaboration
# In production, this should be wss://docs.gruenerator.de
VITE_HOCUSPOCUS_URL=ws://localhost:1240

# ----------------------------------------------------------------------------
# Presenton (AI Presentation Generator)
# ----------------------------------------------------------------------------
# Internal URL for the Presenton Docker service (PPTX/PDF export)
PRESENTON_INTERNAL_URL=http://presenton:80

# LLM provider for Presenton (if using Presenton's own generation)
PRESENTON_LLM=openai
PRESENTON_OPENAI_API_KEY=your_openai_key_here
PRESENTON_OPENAI_MODEL=gpt-4.1

# Image provider
PRESENTON_IMAGE_PROVIDER=pexels
PRESENTON_PEXELS_API_KEY=your_pexels_key_here

# ----------------------------------------------------------------------------
# Logging (Optional)
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json
